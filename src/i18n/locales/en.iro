Locale {
app_about: "WebShield command-line client",

cmd_auth: "Authentication and profiles",
cmd_domains: "Domains (zones)",
cmd_dns: "DNS records",
cmd_sites: "Static sites and publishing",
cmd_proxy: "Proxy/redirect host edge settings",
cmd_stats: "Statistics and protection",
cmd_billing: "Billing (balance, usage, tariffs)",
cmd_completion: "Generate a shell completion script",

arg_profile: "Config profile (defaults to the active one from config.toml)",
arg_api_url: "Base API URL (overrides the profile)",
arg_token: "Personal token `wsk_…` (overrides the profile)",
arg_lang: "Interface language (en/ru); defaults to WS_LANG or the system locale",
arg_output: "Output format",
arg_output_table: "Human-readable table",
arg_output_json: "Machine-readable JSON",
arg_yes: "Do not ask for confirmation on destructive operations",
arg_page: "Page number, 1..n",
arg_shell: "Shell: bash, zsh, fish, powershell, elvish, nushell",
arg_domain: "Domain name",
arg_hostname: "Hostname of the host",

cmd_auth_login: "Store a `wsk_…` token in the profile and verify it",
cmd_auth_status: "Show the active profile and verify API access",
cmd_auth_logout: "Remove the token from the active profile",
arg_login_token: "Token `wsk_…` (prompted interactively if omitted)",
arg_login_api_url: "Base API URL for the profile",

cmd_domains_list: "List your domains",
cmd_domains_add: "Add a domain (create the zone)",
cmd_domains_get: "Show a domain",
cmd_domains_remove: "Delete a domain and its zone",
cmd_domains_check: "Check delegation (NS point to us)",
arg_domain_name: "Domain name, e.g. example.com",
arg_domains_import: "Import existing records on creation: scan | none",

cmd_dns_list: "List DNS records of a domain",
cmd_dns_add: "Add value(s) to a record (appends for A/AAAA/TXT)",
cmd_dns_set: "Replace a record with exactly the given values",
cmd_dns_remove: "Remove record value(s); without values — remove the whole set",
cmd_dns_dnssec: "DNSSEC management",
cmd_dnssec_status: "DNSSEC status and DS records for the registrar",
cmd_dnssec_enable: "Enable online zone signing",
cmd_dnssec_disable: "Disable DNSSEC (blocked while a DS is live in the parent; see --force)",
arg_record_name: "Record name relative to the domain, or `@` for the apex",
arg_record_type: "Record type",
arg_record_type_filter: "Filter by record type (A, AAAA, CNAME, …)",
arg_record_value: "One or more values",
arg_record_value_remove: "Specific values to remove (otherwise the whole rrset is removed)",
arg_record_ttl: "Record TTL, seconds",
arg_dnssec_force: "Remove signing even with a live DS in the parent (risk of SERVFAIL)",

cmd_sites_list: "List static sites",
cmd_sites_create: "Create a static site on a host",
cmd_sites_publish: "Incrementally publish a directory as the site content",
cmd_sites_publish_bucket: "Publish the site from one of your own object-storage buckets",
cmd_sites_files: "List files of the current draft",
cmd_sites_disable: "Unpublish the site",
arg_site_hostname: "Site hostname, e.g. www.example.com",
arg_site_domain: "Owner domain",
arg_publish_hostname: "Site hostname (omit when --site-id is given)",
arg_publish_site_id: "Site id; skips the hostname lookup (useful for narrow sites:publish tokens)",
arg_publish_dir: "Built site directory",
arg_publish_dry_run: "Show the plan without applying changes",
arg_bucket: "Source bucket name (short `<name>` or full `u<id>-<name>`)",
arg_bucket_path: "Source prefix (directory) inside the bucket; empty = bucket root",

cmd_proxy_list: "List proxy/redirect host configs",
cmd_proxy_get: "Show a host config",
cmd_proxy_set: "Create or update a host config (partial update if it exists)",
cmd_proxy_remove: "Remove a host config",
arg_proxy_domain: "Owner domain (required when creating)",
arg_proxy_mode: "Mode: proxy | redirect",
arg_proxy_redirect_target: "Redirect target hostname (for mode=redirect)",
arg_proxy_ssl: "Require HTTPS (true/false)",
arg_proxy_bot_protection: "Bot protection (true/false)",
arg_proxy_captcha: "Captcha challenge (true/false)",
arg_proxy_http2: "HTTP/2 (true/false)",
arg_proxy_http3: "HTTP/3 (true/false)",
arg_proxy_max_body: "Maximum request body size, MB (0 = unlimited)",
arg_proxy_block_bots: "Comma-separated slugs of bots to block",

cmd_stats_summary: "Traffic/requests summary of a domain",
cmd_stats_bans: "Active bans/challenges of a domain",
arg_range: "Time range, e.g. 24h, 7d",
cmd_billing_balance: "Account balance per currency",
cmd_billing_usage: "Traffic usage of a domain vs the tariff limit",
cmd_billing_tariffs: "Current and available tariffs of a domain",

yes: "yes",
no: "no",
dash: "—",
empty: "— empty —",
h_value: "Value",
error_prefix: "error:",
