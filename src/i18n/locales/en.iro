access_unexpected: |code| format!("unexpected response HTTP {code}"),
no_token: |profile| format!("no token for profile `{profile}`.\nRun `webshield auth login --token wsk_…` or set env WS_TOKEN."),

h_id: "ID",
h_domain: "Domain",
h_delegated: "Delegated",
