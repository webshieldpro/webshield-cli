Locale {
app_about: "WebShield command-line client",

cmd_auth: "Authentication and profiles",
cmd_domains: "Domains (zones)",
cmd_dns: "DNS records",
cmd_sites: "Static sites and publishing",
cmd_proxy: "Proxy/redirect host edge settings",
cmd_stats: "Statistics and protection",
cmd_billing: "Billing (balance, usage, tariffs)",
cmd_completion: "Generate a shell completion script",

yes: "yes",
no: "no",
dash: "—",
empty: "— empty —",
h_value: "Value",
error_prefix: "error:",
confirm_suffix: "[y/N]",
confirm_cancelled: "cancelled by user",

token_prompt: "Token wsk_…: ",
token_warn_prefix: "warning: a token usually starts with `wsk_`.",
lbl_profile: "Profile:",
lbl_api_url: "API URL:",
lbl_token: "Token:  ",
lbl_access: "Access: ",
token_set: "set",
token_unset: "not set",
login_hint: "Run `webshield auth login` to store a token.",
token_saved_ok: |profile| format!("token saved to profile `{profile}`, access confirmed."),
token_saved_scoped: |profile| format!("token saved to profile `{profile}` (valid, but narrow scopes)."),
token_saved_code: |code| format!("token saved, but the check returned HTTP {code}."),
token_saved_probe_fail: |err| format!("token saved, but the check failed: {err}"),
token_removed: |profile| format!("token removed from profile `{profile}`."),
profile_not_found: |profile| format!("profile `{profile}` not found — nothing to remove."),
access_ok: "API access confirmed",
access_invalid: "token is invalid (401)",
access_forbidden: "token valid, but no access to domains (403)",
access_unexpected: |code| format!("unexpected response HTTP {code}"),
no_token: |profile| format!("no token for profile `{profile}`.\nRun `webshield auth login --token wsk_…` or set env WS_TOKEN."),

h_id: "ID",
h_domain: "Domain",
h_delegated: "Delegated",
h_tariff: "Tariff",
domain_created: |name, id| format!("domain `{name}` created (id {id})."),
domain_deleted: |name| format!("domain `{name}` deleted."),
domain_not_found: |name| format!("domain `{name}` not found among your domains"),
confirm_delete_domain: |name| format!("Delete domain `{name}` and its zone? This is irreversible."),
delegation_ok: |name| format!("domain `{name}` is delegated to WebShield."),
delegation_not_delegated: |name| format!("domain `{name}` is not delegated."),
delegation_current_ns: |ns| format!("current NS at the parent zone: {ns}"),
delegation_missing_ns: |ns| format!("WebShield nameservers are missing at the registrar: {ns}"),
delegation_extra_ns: |ns| format!("remove the other nameservers at the registrar: {ns}"),
delegation_no_ns: "no NS delegation found in the parent zone.",
delegation_unknown: "delegation status is unknown.",
delegation_propagation_note: "nameserver changes at the registrar can take up to 48 hours to propagate.",

h_name: "Name",
h_type: "Type",
h_ttl: "TTL",
h_proxy: "Proxy",
h_values: "Values",
dns_added: |name, r#type, domain, count| format!("{name} {type} {domain}: values added — {count}."),
dns_set: |name, r#type, domain, count| format!("{name} {type} {domain}: values set — {count}."),
dns_removed: |name, r#type, domain, count| format!("{name} {type} {domain}: values removed — {count}."),
record_not_found: |name, r#type| format!("record {name} {type} not found"),
nothing_to_delete: |name, r#type| format!("nothing to delete: record {name} {type} has no values"),

h_host: "Host",
h_status: "Status",
h_version: "Version",
h_size: "Size",
h_path: "Path",
h_etag: "ETag",
site_created: |host, id| format!("site `{host}` created (id {id})."),
site_disabled: |host| format!("site `{host}` unpublished."),
publish_summary: |id, local, server, up, del, same| format!("Site #{id}: local {local}, server {server} — upload {up}, delete {del}, unchanged {same}."),
publish_no_changes: "no changes — nothing to publish.",
publish_dry_run: "dry-run: no changes applied.",
published: "published.",
bucket_publish_started: "publishing from bucket…",
bucket_published: |version| format!("published from bucket (version {version})."),
bucket_publish_failed: |error| format!("bucket publish failed: {error}"),
bucket_publish_timeout: "bucket publish is still running; check the site status later.",
deleted_files: |count| format!("files deleted: {count}"),
upload_bar: |bar, pos, len| format!("  upload [{bar:30}] {pos}/{len} files"),
not_found_site: |host| format!("static site `{host}` not found"),
publish_needs_site_ref: "specify a site: pass a hostname or --site-id",
not_a_dir: |path| format!("not a directory: {path}"),
dir_not_found: |path| format!("directory not found: {path}"),

h_mode: "Mode",
h_target: "Target",
h_ssl: "SSL",
h_bot_prot: "Bot protection",
proxy_created: |host| format!("proxy config for `{host}` created."),
proxy_updated: |host| format!("proxy config for `{host}` updated."),
proxy_removed: |host| format!("proxy config for `{host}` removed."),
confirm_remove_proxy: |host| format!("Remove edge config for `{host}`?"),
not_found_proxy: |host| format!("proxy config for `{host}` not found"),

h_currency: "Currency",
h_balance: "Balance",
h_metric: "Metric",
h_ip: "IP",
h_reason: "Reason",
h_last_seen: "Last seen",
h_requests: "Requests",
no_bans: "no active bans",

err_network: "network error while calling the API",
err_parse: "failed to parse the API response",
